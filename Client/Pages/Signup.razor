@page "/signup"

@using Domain.Entities
@using SharedKernel.DTOs;
@using Domain.Shared.Resources;
@using Domain.Shared.Resources.Messages;

@inject IJSRuntime JS
@inject HttpClient Http
@inject NavigationManager Navigation

<h3 class="text-center mt-5">@(DataDictionary.SignUp)</h3>

<div class="d-flex justify-content-center mt-4">
	<div class="card p-4 shadow" style="width:350px;">
		<EditForm Model="signupModel" OnValidSubmit="HandleSignupAsync">
			<DataAnnotationsValidator />
			<ValidationSummary />

			<div class="mb-3">
				<label class="form-label">@(DataDictionary.Username)</label>
				<InputText @bind-Value="signupModel.Username" autocompelete="off" class="form-control" />
			</div>

			<div class="mb-3">
				<label class="form-label">@(DataDictionary.Password)</label>
				<InputText @bind-Value="signupModel.Password" autocompelete="off" type="password" class="form-control" />
			</div>

			<div class="mb-3">
				<label class="form-label">@(DataDictionary.ConfirmPassword)</label>
				<InputText @bind-Value="signupModel.Password" autocompelete="off" type="password" class="form-control" />
			</div>

			<div class="mb-3">
				<label class="form-label">@(DataDictionary.FullName)</label>
				<InputText @bind-Value="signupModel.FullName" autocompelete="off" class="form-control" />
			</div>

			<div class="mb-3">
				<label class="form-label">@(DataDictionary.EmailAddress)</label>
				<InputText @bind-Value="signupModel.EmailAddress" autocompelete="off" class="form-control" />
			</div>

			<div class="mb-3">
				<label class="form-label">@(DataDictionary.CellPhoneNumber)</label>
				<InputText @bind-Value="signupModel.CellPhoneNumber" autocompelete="off" class="form-control" />
			</div>

			<button type="submit" class="btn btn-primary w-100" disabled="@isLoading" @onclick="HandleSignupAsync">
				@if (isLoading)
				{
					<span class="spinner-border spinner-border-sm"></span>
					<span class="ms-2">@(DataDictionary.SigningUp)</span>
				}
				else
				{
					<span>@(DataDictionary.SignUp)</span>
				}
			</button>
		</EditForm>

		@if (!string.IsNullOrEmpty(errorMessage))
		{
			<div class="alert alert-danger mt-3 error">@errorMessage</div>
		}
	</div>
</div>

@code {
	private bool isLoading = false;
	private string errorMessage = string.Empty;
	private readonly SignupDto signupModel = new();

	private async Task HandleSignupAsync()
	{
		try
		{
			using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(30));

			isLoading = true;

			var response = await Http
				.PostAsJsonAsync("api/Signup/Register", signupModel, cts.Token);

			if (!response.IsSuccessStatusCode)
			{
				await HandleErrorResponse(response);
				return;
			}

			var result = await response.Content
				.ReadFromJsonAsync<SignupDto>(cancellationToken: cts.Token);

			if (result is null)
			{
				errorMessage = "Unproper Resoponse!";
				return;
			}

			Navigation.NavigateTo("/", replace: true);
		}
		catch (OperationCanceledException)
		{
			errorMessage = "Too long request time!";
		}
		catch (HttpRequestException)
		{
			errorMessage = "Connection to server failed!";
		}
		catch (Exception ex)
		{
			errorMessage = $"Unexpected error: {ex.Message}";
		}
		finally
		{
			isLoading = false;
		}
	}

	private async Task HandleErrorResponse(HttpResponseMessage response)
	{
		var contentType = response
			.Content.Headers.ContentType?.MediaType;

		if (contentType == "application/json")
		{
			var problem = await response.Content
				.ReadFromJsonAsync<ProblemDetailsDto>();

			errorMessage = problem?.Detail
				?? problem?.Title
				?? "An error occured!";
		}
		else
		{
			var text = await response.Content.ReadAsStringAsync();

			errorMessage = string.IsNullOrWhiteSpace(text)
				? "An error occured!"
				: text;
		}
	}
}