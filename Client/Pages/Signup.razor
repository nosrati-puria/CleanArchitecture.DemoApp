@page "/signup"

@using Domain.Entities
@using SharedKernel.DTOs;
@using Domain.Shared.Resources;
@using Domain.Shared.Resources.Messages;

@inject IJSRuntime JS
@inject HttpClient Http
@inject NavigationManager Navigation

<h3 class="text-center mt-5">Sign Up</h3>

<div class="d-flex justify-content-center mt-4">
	<div class="card p-4 shadow" style="width:350px;">
		<EditForm Model="signupModel" OnValidSubmit="HandleSignupAsync">
			<DataAnnotationsValidator />
			<ValidationSummary />

			<div class="mb-3">
				<label class="form-label">@nameof(Domain.Entities.Employee.Username)</label>
				<InputText @bind-Value="signupModel.Username" class="form-control" />
			</div>

			<div class="mb-3">
				<label class="form-label">@nameof(Domain.Entities.Employee.Password)</label>
				<InputText @bind-Value="signupModel.Password" type="password" class="form-control" />
			</div>

			<div class="mb-3">
				<label class="form-label">@nameof(Domain.Entities.Employee.FullName)</label>
				<InputText @bind-Value="signupModel.FullName" class="form-control" />
			</div>

			<div class="mb-3">
				<label class="form-label">@nameof(Domain.Entities.Employee.Email)</label>
				<InputText @bind-Value="signupModel.Email" class="form-control" />
			</div>

			<div class="mb-3">
				<label class="form-label">@nameof(Employee.CellPhoneNumber)</label>
				<InputText @bind-Value="signupModel.CellPhoneNumber" class="form-control" />
			</div>

			<button type="submit" class="btn btn-primary w-100">@(DataDictionary.SignUp)</button>
		</EditForm>

		@if (!string.IsNullOrEmpty(errorMessage))
		{
			<div class="alert alert-danger mt-3">@errorMessage</div>
		}
	</div>
</div>

@code {
	private string errorMessage = string.Empty;
	private readonly SignupDto signupModel = new();

	private async Task HandleSignupAsync()
	{
		try
		{
			var response = await Http.PostAsJsonAsync("https://localhost:44325/api/Signup/Register", signupModel);

			if (!response.IsSuccessStatusCode)
			{
				var serverMessage = await response.Content.ReadAsStringAsync();
				errorMessage = nameof(Errors.InvalidUsernameOrPassword);

				if (!string.IsNullOrWhiteSpace(serverMessage))
				{
					errorMessage += $": {serverMessage}";
				}

				return;
			}

			var result = await response.Content.ReadFromJsonAsync<LoginResponseDto>();

			if (result is null || string.IsNullOrWhiteSpace(result.Token))
			{
				errorMessage = Errors.EmptyToken;
				return;
			}

			await JS.InvokeVoidAsync("localStorage.setItem", "jwt", result.Token);

			Navigation.NavigateTo("/");
		}
		catch (JSException jsEx)
		{
			errorMessage = $@"خطا در ذخیره‌سازی توکن در مرورگر: {jsEx.Message}";
		}
		catch (Exception ex)
		{
			errorMessage = $"خطا: {ex.Message}";
		}
	}
}