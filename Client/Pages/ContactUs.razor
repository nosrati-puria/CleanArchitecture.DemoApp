@page "/contact_us"
@inject HttpClient Http

<PageTitle>Contact Us</PageTitle>

<h1>Contact Us</h1>

<p>This component demonstrates fetching data from the server.</p>

@if (_contact == null)
{
	<p><em>Loading...</em></p>
}
else
{
	<table class="table">
		<thead>
			<tr>
				<th>Full Name</th>
				<th>Age</th>
				<th>Phone Number</th>
				<th>Description</th>
			</tr>
		</thead>
		<tbody>
			<tr>
				<td>@_contact.FullName</td>
				<td>@_contact.Age</td>
				<td>@_contact.PhoneNumber</td>
				<td>@_contact.Description</td>
			</tr>
		</tbody>
	</table>
}

@code {
	private Contact _contact { get; set; } = new Contact
	{
		FullName = "Puria Nosrati",
		Age = 29,
		PhoneNumber = "123"
	};

	public class Contact()
	{
		public string FullName { get; set; }

		public byte Age { get; set; }

		public string Description { get; set; }

		public string PhoneNumber { get; set; }
	}
}