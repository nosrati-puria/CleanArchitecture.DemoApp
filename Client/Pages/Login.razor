@page "/login"

@using SharedKernel.DTOs;
@using Domain.Shared.Resources;
@using Domain.Shared.Resources.Messages;

@inject IJSRuntime JS
@inject HttpClient Http
@inject NavigationManager Navigation

<h3 class="text-center mt-5">@(DataDictionary.SignIn)</h3>

<div class="d-flex justify-content-center mt-4">
	<div class="card p-4 shadow" style="width:350px;">
		<EditForm Model="loginModel" OnValidSubmit="HandleLoginAsync">
			<DataAnnotationsValidator />
			<ValidationSummary />

			<div class="mb-3">
				<label class="form-label">@(DataDictionary.Username)</label>
				<InputText @bind-Value="loginModel.Username" class="form-control" />
			</div>

			<div class="mb-3">
				<label class="form-label">@(DataDictionary.Password)</label>
				<InputText @bind-Value="loginModel.Password" type="password" class="form-control" />
			</div>

			<button type="submit" class="btn btn-primary w-100" disabled="@isLoading" @onclick="HandleLoginAsync">
				@if (isLoading)
				{
					<span class="spinner-border spinner-border-sm"></span>
					<span class="ms-2">@(DataDictionary.SigningIn)</span>
				}
				else
				{
					<span>@(DataDictionary.SignIn)</span>
				}
			</button>

			<div class="text-center mt-3">
				<span>Don't have an account?</span>
				<a href="/Signup" class="ms-1 bold">@(DataDictionary.SignUp)</a>
			</div>
		</EditForm>

		@if (!string.IsNullOrEmpty(errorMessage))
		{
			<div class="alert alert-danger mt-3 error">@errorMessage</div>
		}
	</div>
</div>

@code {
	private bool isLoading = false;
	private string errorMessage = string.Empty;
	private readonly LoginRequestDto loginModel = new();

	private async Task HandleLoginAsync()
	{
		try
		{
			var response = await Http.PostAsJsonAsync("api/Auth/Login", loginModel);

			isLoading = true;

			if (!response.IsSuccessStatusCode)
			{
				var serverMessage = await response.Content.ReadFromJsonAsync<SharedKernel.Error>();
				errorMessage = serverMessage?.Message;

				return;
			}

			var result = await response.Content.ReadFromJsonAsync<LoginResponseDto>();

			if (result is null || string.IsNullOrWhiteSpace(result.Token))
			{
				errorMessage = Errors.EmptyToken;
				return;
			}

			await JS.InvokeVoidAsync("localStorage.setItem", "jwt", result.Token);

			Navigation.NavigateTo("/");
		}
		catch (JSException jsEx)
		{
			errorMessage = $@"خطا در ذخیره‌سازی توکن در مرورگر: {jsEx.Message}";
		}
		catch (Exception ex)
		{
			errorMessage = $"خطا: {ex.Message}";
		}
		finally
		{
			isLoading = false;
		}
	}
}